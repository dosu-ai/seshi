# Copy to .env and keep it private (chmod 600): it holds tokens and keys. It works unedited:
# a file store on the kit's volume, and no tokens until `docker compose exec seshi seshi admin
# init` makes the first ones.
#
# Compose reads this file for the kit's own names, and the container reads it for its SESHI_*
# settings (docs/config.md: SESHI_ plus the TOML path in upper case, with __ between levels).
# The server refuses a SESHI_* name that is not a setting, so never invent one here.

# The kit (Compose settings, not seshi's).
# IMAGE_TAG=                 # another release than the one compose.yaml pins, or X.Y.Z@sha256:…
# IMAGE_REPOSITORY=ghcr.io/dosu-ai/seshi
# HOST_PORT=7200             # the host port; the container always listens on 7200
# BIND_ADDRESS=127.0.0.1     # 0.0.0.0 publishes on every interface: put TLS in front first
# COMPOSE_FILE=compose.yaml:compose.tls.yaml   # add-ons to use every time (; between them on Windows)
# SITE_ADDRESS=seshi.example.com               # compose.tls.yaml: the server's DNS name
# HTTP_PORT=80                                 # compose.tls.yaml
# HTTPS_PORT=443                               # compose.tls.yaml
# BUCKET_ACCESS_KEY=                           # compose.bucket.yaml: openssl rand -hex 16
# BUCKET_SECRET_KEY=                           # compose.bucket.yaml: openssl rand -hex 32

# Who may use the server (docs/config.md, [auth]).
# A team: set nothing here. After the first start, run
#   docker compose exec seshi seshi admin init
# which prints the first admin token and the org key that members use with `seshi login --key`.
# One person: a static token, 16+ characters (openssl rand -hex 24).
# SESHI_AUTH__TOKENS__DEFAULT=
# An IdP: its issuer and client id, and a session key of 32+ characters (openssl rand -hex 32).
# SESHI_AUTH__OIDC__ISSUER=https://acme.okta.com
# SESHI_AUTH__OIDC__CLIENT_ID=
# SESHI_AUTH__SESSION_KEYS__K1=

# Where sessions go. The default is the kit's volume, which a recreated container keeps.
SESHI_STORE__URL=file:///data
# A bucket instead (or compose.bucket.yaml for a bundled one):
#   s3://bucket/prefix  + SESHI_STORE__REGION and the credentials
#   s3://bucket/prefix  + SESHI_STORE__ENDPOINT, for MinIO, Backblaze, Wasabi and the like
#   r2://bucket/prefix  + SESHI_STORE__ACCOUNT_ID and the credentials
# SESHI_STORE__URL=s3://bucket/prefix
# SESHI_STORE__REGION=
# SESHI_STORE__ENDPOINT=
# SESHI_STORE__ACCOUNT_ID=
# SESHI_STORE__CREDENTIALS__ACCESS_KEY_ID=
# SESHI_STORE__CREDENTIALS__SECRET_ACCESS_KEY=

# Optional.
# SESHI_STORE__DEPLOYMENT_ID=prod   # this deployment's id; the server refuses a bucket marked for another
# SESHI_STORE__ORG=acme              # the organization it serves
