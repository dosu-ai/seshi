{
  "name": "sessiondb-workspace",
  "private": true,
  "description": "seshi: capture, ingest, redact, store and search coding-agent sessions. One binary (apps/seshi), its TypeScript packages (packages/ts), the vendor integrations (integrations), and the contract they honour (spec).",
  "license": "MIT",
  "repository": "github:dosu-ai/sessiondb",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/ts/*",
    "integrations/*"
  ],
  "scripts": {
    "start": "bun run apps/seshi/src/main.ts serve",
    "dev": "bun --watch run apps/seshi/src/main.ts serve",
    "seshi": "bun run apps/seshi/src/main.ts",
    "build": "bun run scripts/build-binary.ts",
    "release:build": "bun run scripts/release/build.ts",
    "release:npm": "bun run scripts/release/npm.ts",
    "release:publish-npm": "bun run scripts/release/publish-npm.ts",
    "release:smoke": "bun run scripts/release/smoke.ts",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:laptop": "bun --bun vitest run --config vitest.laptop.config.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome lint .",
    "format": "bunx biome format --write .",
    "check": "bunx biome check . && bun run check:layers && bun run check:schema && bun run check:types && bun run check:hook --static-only && bun run check:brand",
    "check:layers": "bun run scripts/check-layers.ts",
    "check:schema": "bun run scripts/config-schema.ts --check",
    "check:types": "bun run scripts/model-types.ts --check",
    "check:hook": "bun run scripts/check-hook.ts",
    "check:brand": "bun run scripts/brand-tokens.ts --check",
    "schema": "bun run scripts/config-schema.ts",
    "types": "bun run scripts/model-types.ts",
    "packs": "bun run scripts/builtin-pack.ts",
    "brand": "bun run scripts/brand-tokens.ts",
    "brand:outline": "bun run scripts/brand/outline-wordmark.ts",
    "fixtures": "bun run tests/tooling/fixtures.ts",
    "goldens": "bun run tests/tooling/write-goldens.ts",
    "scenarios:explore": "bun run tests/tooling/scenario/explore.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@seshi/api": "workspace:*",
    "@seshi/auth": "workspace:*",
    "@seshi/capture": "workspace:*",
    "@seshi/client": "workspace:*",
    "@seshi/config": "workspace:*",
    "@seshi/formats": "workspace:*",
    "@seshi/instance": "workspace:*",
    "@seshi/kit": "workspace:*",
    "@seshi/model": "workspace:*",
    "@seshi/pipeline": "workspace:*",
    "@seshi/redact": "workspace:*",
    "@seshi/review": "workspace:*",
    "@seshi/search": "workspace:*",
    "@seshi/sources": "workspace:*",
    "@seshi/store": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/fontkit": "2.0.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "fontkit": "2.0.4",
    "semantic-release": "^25.0.9",
    "seshi": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
