{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "customConditions": ["bun"]
  },
  "include": [
    "apps/*/src/**/*",
    "packages/ts/*/src/**/*",
    "integrations/*/src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "vitest.config.ts",
    "vitest.laptop.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
