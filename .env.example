# Copy to .env (gitignored). Bun reads it from the working directory; docker compose passes it
# to the container. Every setting is in docs/config.md: SESHI_ plus the TOML path in upper
# case, with __ between levels ([store] url is SESHI_STORE__URL). A seshi.toml works too
# (seshi.example.toml), with these variables over it. Check with: seshi config check

# Who may use the server: one token per person, SESHI_AUTH__TOKENS__<NAME>. Sessions are
# filed under owners/<name>/ and a token reads only its own. Tokens are 16+ characters:
#   openssl rand -hex 24
SESHI_AUTH__TOKENS__ALICE=replace-with-openssl-rand-hex-24
SESHI_AUTH__TOKENS__BOB=replace-with-another
# One person? A single token named default files under owners/default/:
# SESHI_AUTH__TOKENS__DEFAULT=replace-with-openssl-rand-hex-24
# Hosting many people? Set a secret and let an issuer that shares it mint signed tokens
# (HS256 JWT, sub = owner, exp required); the tokens above may then be left out. 32+ characters:
#   openssl rand -hex 32
# SESHI_AUTH__LEGACY_TOKEN_SECRET=

# Where sessions go. One of:
#   r2://bucket/prefix     + SESHI_STORE__ACCOUNT_ID and the credentials below
#   s3://bucket/prefix     + SESHI_STORE__REGION and the credentials below
#   s3://bucket/prefix     + SESHI_STORE__ENDPOINT, for MinIO / Backblaze / Wasabi / …
#   file:///path           a folder on this machine (development; the Docker image mounts /data)
SESHI_STORE__URL=file:///tmp/seshi
# SESHI_STORE__ACCOUNT_ID=
# SESHI_STORE__REGION=
# SESHI_STORE__ENDPOINT=
# SESHI_STORE__CREDENTIALS__ACCESS_KEY_ID=
# SESHI_STORE__CREDENTIALS__SECRET_ACCESS_KEY=
# Without them, the standard AWS_* / S3_* (or R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY) apply.

# Optional.
# SESHI_REDACTION__PACKS=./redaction.json   # your own patterns, files, commands (docs/server.md)
# SESHI_STORE__DEPLOYMENT_ID=prod   # this deployment's id; the server refuses a bucket marked for another
# SESHI_STORE__ORG=acme              # the organization it serves (X1.4)
# SESHI_SERVER__LISTEN=:7200    # where the server listens
# HOST_PORT=7200                # docker compose only: the host port to publish
