# Copy to .env (gitignored). `bun start` from a checkout reads it from the working directory, and
# docker compose passes it to the container. The installed seshi binary does not read .env:
# export these variables or use a seshi.toml there. Every setting is in docs/config.md: SESHI_
# plus the TOML path in upper case, with __ between levels ([store] url is SESHI_STORE__URL). A
# seshi.toml works too (seshi.example.toml), with these variables over it. Check with:
# seshi config check

# Who may use the server (docs/config.md, [auth]). For a team: run `seshi admin init` once
# where this config is; it prints the first admin token and the org key, which every member
# sets with `seshi login --key` and writes as the username they state. With an IdP, set
# SESHI_AUTH__OIDC__ISSUER and __CLIENT_ID and a session key (32+ characters):
#   openssl rand -hex 32
# SESHI_AUTH__OIDC__ISSUER=https://acme.okta.com
# SESHI_AUTH__OIDC__CLIENT_ID=
# SESHI_AUTH__SESSION_KEYS__K1=
# For one person or development, static tokens from config instead, one per owner,
# SESHI_AUTH__TOKENS__<NAME>, 16+ characters (openssl rand -hex 24). The server refuses the
# replace-with-… values below until they are replaced:
SESHI_AUTH__TOKENS__ALICE=replace-with-openssl-rand-hex-24
SESHI_AUTH__TOKENS__BOB=replace-with-another
# One person? A single token named default files under owners/default/:
# SESHI_AUTH__TOKENS__DEFAULT=replace-with-openssl-rand-hex-24

# Where sessions go. One of:
#   r2://bucket/prefix     + SESHI_STORE__ACCOUNT_ID and the credentials below
#   s3://bucket/prefix     + SESHI_STORE__REGION and the credentials below
#   s3://bucket/prefix     + SESHI_STORE__ENDPOINT, for MinIO / Backblaze / Wasabi / …
#   az://container/prefix  + SESHI_STORE__ACCOUNT_NAME and AZURE_STORAGE_KEY (or
#                            AZURE_STORAGE_SAS_TOKEN, or AKS workload identity)
#   file:///path           a folder on this machine (development, or one machine)
# docker compose keeps its volume at /data: a file:// store anywhere else in the container is
# lost when the container is recreated. For `bun start`, name a folder you can write instead,
# such as file:///tmp/seshi.
SESHI_STORE__URL=file:///data
# SESHI_STORE__ACCOUNT_ID=
# SESHI_STORE__REGION=
# SESHI_STORE__ENDPOINT=
# SESHI_STORE__ACCOUNT_NAME=
# SESHI_STORE__CREDENTIALS__ACCESS_KEY_ID=
# SESHI_STORE__CREDENTIALS__SECRET_ACCESS_KEY=
# Without them, the standard AWS_* / S3_* (or R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY) apply.

# Optional.
# SESHI_REDACTION__PACKS=./redaction.json   # your own rule packs (docs/redaction.md)
# SESHI_STORE__DEPLOYMENT_ID=prod   # this deployment's id; the server refuses a bucket marked for another
# SESHI_STORE__ORG=acme              # the organization it serves (X1.4)
# SESHI_SERVER__LISTEN=:7200    # where the server listens
# HOST_PORT=7200                # docker compose only: the host port to publish
